# Diretório local para persistir fingerprints de vagas já processadas.
RADAR_DATA_DIR=data

# Reservados para uma futura integração oficial com o Telegram.
# Não preencha estes valores neste estágio inicial.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configuração operacional opcional.
RADAR_TIMEZONE=America/Sao_Paulo
RADAR_LOG_LEVEL=INFO